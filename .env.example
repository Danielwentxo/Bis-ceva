# Copy relevant lines into your actual deploy environment (Grok's deploy env
# var settings, or a local .env). Nothing here is required for email/password
# login or the Grok Google/X buttons to keep working — these only add extras.

# --- Google sign-in (direct, not via the Grok broker) ---
# Free. console.cloud.google.com -> APIs & Services -> Credentials ->
# "Create Credentials" -> "OAuth client ID" (type: Web application).
# Authorized redirect URI: <your app URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in ---
# Requires a PAID Apple Developer account ($99/year). developer.apple.com ->
# Certificates, Identifiers & Profiles -> Identifiers -> create a "Services ID"
# with "Sign in with Apple" enabled (this is APPLE_CLIENT_ID). Redirect URI:
# <your app URL>/api/auth/callback/apple
# APPLE_CLIENT_SECRET is a short-lived signed JWT (not a plain secret) that you
# generate following Apple's docs: https://developer.apple.com/documentation/sign_in_with_apple/generate_and_validate_tokens
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Password reset emails ---
# Free tier (100 emails/day). resend.com -> create account -> API Keys.
RESEND_API_KEY=
# Optional — defaults to Resend's shared test sender if omitted.
RESEND_FROM_EMAIL=
